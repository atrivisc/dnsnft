[Unit]
Description=Fill nftables sets from DNS answers
Documentation=https://github.com/atrivisc/dnsnft
After=network.target nftables.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/dnsnft
ExecStart=/usr/bin/dnsnft -d /etc/dnsnft/domains.conf $DNSNFT_OPTS
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
